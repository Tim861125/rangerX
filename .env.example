# 選用：設定後，手動更新 API 必須帶 Bearer token。
NUXT_SYNC_TOKEN=

# 圖片 CDN 基底網址（例如自訂網域 https://img.rangerx.com 或 R2 Public URL）
# 若未設定，將預設使用外部原始圖源 https://res.warmycat.com
NUXT_PUBLIC_IMAGE_ORIGIN=

# Cloudflare R2 S3 API 設定（用於執行 just sync-images 批次上傳）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rangerx-images

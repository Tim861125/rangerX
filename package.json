{
  "name": "rangerX",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "check": "bun run typecheck && bun run test && bun run build",
    "cf:types": "wrangler types server/types/worker-configuration.d.ts --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy",
    "deploy:dry": "bun run build && wrangler deploy --dry-run",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "bun run build && wrangler dev",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.3",
    "shadcn-nuxt": "^2.8.2",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "nitro-cloudflare-dev": "^0.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.120.1"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rangerx",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rangerx-db",
      "database_id": "a6d4730d-592f-41a7-a1d5-690499b3b691",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SOURCE_API_URL": "https://rangerbook.warmycat.com/res/Rangers_data.json"
  }
}

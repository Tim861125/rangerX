{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "rangerx",
	"pages_build_output_dir": "./dist",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rangerx-db",
			"database_id": "a6d4730d-592f-41a7-a1d5-690499b3b691",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "rangerx-images"
		}
	],
	"vars": {
		"SOURCE_API_URL": "https://rangerbook.warmycat.com/res/Rangers_data.json",
		"NUXT_PUBLIC_IMAGE_ORIGIN": "https://pub-175d5bd828ad4a199849c106c833472a.r2.dev"
	}
}